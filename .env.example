# Site origin (no trailing slash). Drives canonical URLs, OG/Twitter tags,
# robots.txt, sitemap.xml, JSON-LD. Falls back to http://localhost:3000 when
# unset — set it in production.
NEXT_PUBLIC_SITE_URL=

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, submissions are logged server-side.
CONTACT_ENDPOINT=

# Anthropic API key — used only by scripts/translate-content.mjs (a one-time
# dev tool, not part of `next build` or any runtime request) to translate
# the site's English copy into the other locales. See decisions-log ADR-0029
# and environment-variables.md.
ANTHROPIC_API_KEY=
