# Site origin (no trailing slash). Drives canonical URLs, OG/Twitter tags,
# robots.txt, sitemap.xml, JSON-LD. Falls back to http://localhost:3000 when
# unset — set it in production.
NEXT_PUBLIC_SITE_URL=

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, submissions are logged server-side.
CONTACT_ENDPOINT=

# Optional LibreTranslate API key — used only by scripts/translate-content.mjs
# (a one-time dev tool, not part of `next build` or any runtime request) to
# translate the site's English copy into the other locales. Not required: the
# script defaults to a free public LibreTranslate instance that accepts
# anonymous requests. Set this only if that instance stops working, or to use
# the official https://libretranslate.com with a free-tier key instead (pair
# with LIBRETRANSLATE_URL=https://libretranslate.com/translate). See
# decisions-log ADR-0032 and environment-variables.md.
LIBRETRANSLATE_API_KEY=
